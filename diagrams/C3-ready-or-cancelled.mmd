%%{init: {"fontFamily": "arial", "sequence": {"actorMargin": 50, "messageMargin": 40, "noteMargin": 12, "boxMargin": 10, "labelBoxWidth": 75, "mirrorActors": false, "showSequenceNumbers": false, "actorFontFamily": "arial", "noteFontFamily": "arial", "messageFontFamily": "arial", "actorFontSize": 18, "messageFontSize": 18, "noteFontSize": 17}, "themeCSS": ".messageText,.loopText,.loopText tspan,.sectionTitle,.sectionTitle tspan{stroke:#fff;stroke-width:10px;stroke-linejoin:round;paint-order:stroke}"}}%%
sequenceDiagram
    actor Helen
    participant TP as TrackingPage
    participant TC as TrackingController
    participant OS as OrderStore
    participant RS as RestaurantStore

    Helen->>TP: Look at the tracking page
    TP->>TC: getTracking(token)
    TC->>OS: findByToken(token)
    OS-->>TC: status, cancel reason
    TC->>RS: readRestaurant()
    RS-->>TC: instructions, contact
    TC-->>TP: status, reason, instructions, contact
    Note right of RS: Cancelled: Helen can<br/>make other arrangements.<br/>Received, Preparing:<br/>no instructions yet.
    alt Ready
        TP-->>Helen: Collection instructions, number
    else Cancelled
        TP-->>Helen: Staff reason, restaurant contact
    end
