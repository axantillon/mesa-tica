{
  "name": "mesa-tica",
  "version": "1.0.0",
  "private": true,
  "description": "Mesa Tica pickup ordering: guest menu, cart and checkout, private order tracking and a staff order queue.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node --disable-warning=ExperimentalWarning src/setup.js",
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
